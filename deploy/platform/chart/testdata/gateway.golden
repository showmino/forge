# Source: forge/templates/tests/forge-test.yaml
apiVersion: v1
kind: Pod
metadata:
  name: forge-test
  namespace: forge
  labels:
    app.kubernetes.io/part-of: forge
    app.kubernetes.io/managed-by: Helm
    helm.sh/chart: forge-0.27.0
  annotations:
    helm.sh/hook: test
    helm.sh/hook-delete-policy: before-hook-creation,hook-succeeded
spec:
  restartPolicy: Never
  automountServiceAccountToken: false
  securityContext:
    runAsNonRoot: true
    runAsUser: 65532
    seccompProfile: {type: RuntimeDefault}
  containers:
    # Through the public address: the API answers, and the login serves its
    # discovery document with the issuer the API trusts.
    - name: test
      image: mirror.gcr.io/curlimages/curl:8.16.0
      command: [sh, -ec]
      args:
        - |
          curl -fsS -X POST -H 'Content-Type: application/json' -d '{}' https://api.acme.example/forge.v1.AuthService/GetServerInfo
          echo
          curl -fsS https://login.acme.example/dex/.well-known/openid-configuration | grep -F '"issuer": "https://login.acme.example/dex"'
      securityContext:
        allowPrivilegeEscalation: false
        readOnlyRootFilesystem: true
        capabilities: {drop: [ALL]}
