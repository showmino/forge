---
# Source: forge/templates/forge-api.yaml
apiVersion: v1
kind: ServiceAccount
metadata:
  name: forge-api
  namespace: forge
  labels:
    app.kubernetes.io/part-of: forge
    app.kubernetes.io/managed-by: Helm
    helm.sh/chart: forge-0.27.0
---
# Source: forge/templates/dex.yaml
apiVersion: v1
kind: ConfigMap
metadata:
  name: dex-config
  namespace: forge
  labels:
    app.kubernetes.io/part-of: forge
    app.kubernetes.io/managed-by: Helm
    helm.sh/chart: forge-0.27.0
data:
  config.yaml: |
    issuer: https://login.acme.example/dex
    storage:
      type: postgres
      config:
        host: "db.acme.example"
        port: 5432
        database: "forge_login"
        user: "forge_app"
        password: $DEX_DB_PASSWORD
        ssl:
          mode: "require"
    web:
      http: 0.0.0.0:5556
      allowedOrigins: ["https://forge.acme.example"]
    oauth2:
      grantTypes: [authorization_code, refresh_token, "urn:ietf:params:oauth:grant-type:device_code"]
      skipApprovalScreen: true
    expiry:
      idTokens: 1h
    staticClients:
      - id: forge-cli
        name: Forge CLI
        public: true
        redirectURIs: [/device/callback, http://127.0.0.1:8085/callback]
      - id: forge-web
        name: Forge dashboard
        public: true
        redirectURIs: ["https://forge.acme.example/auth/callback"]
    # Only members of the org sign in; groups are "<org>:<team-slug>", and
    # github.adminTeams picks the admins among them.
    connectors:
      - type: github
        id: github
        name: GitHub
        config:
          clientID: $GITHUB_CLIENT_ID
          clientSecret: $GITHUB_CLIENT_SECRET
          redirectURI: https://login.acme.example/dex/callback
          orgs:
            - name: acme
          teamNameField: slug
---
# Source: forge/templates/dex.yaml
apiVersion: v1
kind: Service
metadata:
  name: dex
  namespace: forge
  labels:
