# Optional: the 1Password operator syncs the GitHub App key into the Secret
# forge-github-app. render.sh adds this when FORGE_ONEPASSWORD_ITEM is set,
# e.g. vaults/Kube/items/forge-github-app. The item needs a field named
# github_app_private_key holding the App's private key (PEM).
apiVersion: onepassword.com/v1
kind: OnePasswordItem
metadata:
  name: forge-github-app
  namespace: forge
spec:
  itemPath: ${FORGE_ONEPASSWORD_ITEM}
