# Cluster capacity: what `forge cluster` needs on the cluster. render.sh adds
# this when FORGE_CLUSTERS=1. Read only: exactly the calls
# internal/server/clusters.go makes, with forge-api's ServiceAccount.
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: forge-api-clusters
rules:
  - apiGroups: [""]
    resources: [nodes]
    verbs: [list]
  - apiGroups: [""]
    resources: [pods]
    verbs: [list]
  # With Prometheus: to tie volumes to their Forge service. #prometheus
  - apiGroups: [""] #prometheus
    resources: [namespaces] #prometheus
    verbs: [list] #prometheus
  - apiGroups: [metrics.k8s.io]
    resources: [nodes]
    verbs: [list]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: forge-api-clusters
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: forge-api-clusters
subjects:
  - {kind: ServiceAccount, name: forge-api, namespace: forge}
--- #remoteclusters
# Other clusters: forge-api reads exactly the Argo CD cluster Secrets named in #remoteclusters
# FORGE_REMOTE_CLUSTERS, and with their credentials those clusters. #remoteclusters
apiVersion: rbac.authorization.k8s.io/v1 #remoteclusters
kind: Role #remoteclusters
metadata: #remoteclusters
  name: forge-api-remote-clusters #remoteclusters
  namespace: argocd #remoteclusters
rules: #remoteclusters
  - apiGroups: [""] #remoteclusters
    resources: [secrets] #remoteclusters
    resourceNames: [${REMOTE_CLUSTERS_YAML}] #remoteclusters
    verbs: [get] #remoteclusters
--- #remoteclusters
apiVersion: rbac.authorization.k8s.io/v1 #remoteclusters
kind: RoleBinding #remoteclusters
metadata: #remoteclusters
  name: forge-api-remote-clusters #remoteclusters
  namespace: argocd #remoteclusters
roleRef: #remoteclusters
  apiGroup: rbac.authorization.k8s.io #remoteclusters
  kind: Role #remoteclusters
  name: forge-api-remote-clusters #remoteclusters
subjects: #remoteclusters
  - {kind: ServiceAccount, name: forge-api, namespace: forge} #remoteclusters
