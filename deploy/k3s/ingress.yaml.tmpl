# Stock k3s: Dex and forge-api behind the bundled Traefik ingress.
#   ${DEX_HOST}  e.g. dex.192.168.1.50.nip.io
#   ${API_HOST}  e.g. forge.192.168.1.50.nip.io
apiVersion: v1
kind: Service
metadata:
  name: dex
  namespace: forge
spec:
  selector: {app: dex}
  ports:
    - {name: http, port: 5556, targetPort: http}
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: dex
  namespace: forge
spec:
  ingressClassName: traefik
  rules:
    - host: ${DEX_HOST}
      http:
        paths:
          - path: /dex
            pathType: Prefix
            backend:
              service: {name: dex, port: {name: http}}
---
apiVersion: v1
kind: Service
metadata:
  name: forge-api
  namespace: forge
  annotations:
    # Traefik talks HTTP/2 cleartext to the pod, so gRPC clients work too.
    traefik.ingress.kubernetes.io/service.serversscheme: h2c
spec:
  selector: {app: forge-api}
  ports:
    - {name: http, port: 80, targetPort: http}
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: forge-api
  namespace: forge
spec:
  ingressClassName: traefik
  rules:
    - host: ${API_HOST}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service: {name: forge-api, port: {name: http}}
