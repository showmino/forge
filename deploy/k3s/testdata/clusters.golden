# Cluster capacity: what `forge cluster` needs on the cluster. render.sh adds
# this when FORGE_CLUSTERS=1. Read only: exactly the calls
# internal/server/clusters.go makes, with forge-api's ServiceAccount.
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: forge-api-clusters
rules:
  - apiGroups: [""]
    resources: [nodes]
    verbs: [list]
  - apiGroups: [""]
    resources: [pods]
    verbs: [list]
  # With Prometheus: to tie volumes to their Forge service.
  - apiGroups: [""]
    resources: [namespaces]
    verbs: [list]
  - apiGroups: [metrics.k8s.io]
    resources: [nodes]
    verbs: [list]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: forge-api-clusters
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: forge-api-clusters
subjects:
  - {kind: ServiceAccount, name: forge-api, namespace: forge}
---
# Other clusters: forge-api reads exactly the Argo CD cluster Secrets named in
# FORGE_REMOTE_CLUSTERS, and with their credentials those clusters.
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: forge-api-remote-clusters
  namespace: argocd
rules:
  - apiGroups: [""]
    resources: [secrets]
    resourceNames: ["aks-production", "lab"]
    verbs: [get]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: forge-api-remote-clusters
  namespace: argocd
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: forge-api-remote-clusters
subjects:
  - {kind: ServiceAccount, name: forge-api, namespace: forge}
