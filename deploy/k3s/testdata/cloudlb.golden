# Forge Phase 1 on k3s: Dex + forge-api. How they are reached comes from
# ingress.yaml.tmpl (Traefik) or loadbalancer.yaml.tmpl (MetalLB and similar).
# Render with deploy/k3s/render.sh; do not apply this file directly.
#   dex.example.test         host name of Dex, the same for you and for pods
#   forge-api:dev  e.g. forge-api:dev (imported into k3s) or ghcr.io/showmino/forge-api:v0.1.0
#   The GitHub App settings (ID, org, template repo): see render.sh.
#   FORGE_DEX_GITHUB_ORG, FORGE_WRITER_GROUPS (render.sh): GitHub login and who is an admin.
#   Lines with a trailing "app" marker comment exist only when render.sh gets a GitHub App ID.
apiVersion: v1
kind: Namespace
metadata:
  name: forge
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: dex-config
  namespace: forge
data:
  config.yaml: |
    issuer: http://dex.example.test/dex
    storage:
      type: postgres
      config:
        host: forge-db-rw.forge.svc
        port: 5432
        database: dex
        user: forge
        password: $DEX_DB_PASSWORD # from the Secret forge-db-app
        ssl:
          mode: require
    web:
      http: 0.0.0.0:5556
    oauth2:
      grantTypes: [authorization_code, refresh_token, "urn:ietf:params:oauth:grant-type:device_code"]
      skipApprovalScreen: true
    expiry:
      idTokens: 1h
    staticClients:
      - id: forge-cli
        name: Forge CLI
        public: true
        redirectURIs: [/device/callback, http://127.0.0.1:8085/callback]
    # Only members of the org log in; groups are "<org>:<team-slug>", and
    # forge-api's FORGE_WRITER_GROUPS picks the admin teams. Dex
    # expands $GITHUB_CLIENT_* from its environment (the Secret dex-github).
    connectors:
      - type: github
        id: github
        name: GitHub
        config:
          clientID: $GITHUB_CLIENT_ID
          clientSecret: $GITHUB_CLIENT_SECRET
          redirectURI: http://dex.example.test/dex/callback
          orgs:
            - name: showmino
          teamNameField: slug
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: dex
  namespace: forge
spec:
  replicas: 1
  selector:
    matchLabels: {app: dex}
  template:
    metadata:
      labels: {app: dex}
    spec:
      containers:
        - name: dex
          image: ghcr.io/dexidp/dex:v2.41.1
          args: [dex, serve, /etc/dex/config.yaml]
          env:
            - name: GITHUB_CLIENT_ID
              valueFrom:
                secretKeyRef: {name: dex-github, key: client_id}
            - name: GITHUB_CLIENT_SECRET
              valueFrom:
                secretKeyRef: {name: dex-github, key: client_secret}
            - name: DEX_DB_PASSWORD
              valueFrom:
                secretKeyRef: {name: forge-db-app, key: password}
          ports:
            - {name: http, containerPort: 5556}
          readinessProbe:
            httpGet: {path: /dex/healthz, port: http}
          volumeMounts:
            - {name: config, mountPath: /etc/dex}
          resources:
            requests: {cpu: 10m, memory: 32Mi}
            limits: {memory: 128Mi}
      volumes:
        - name: config
          configMap: {name: dex-config}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: forge-api
  namespace: forge
spec:
  replicas: 1 # operations are in memory; keep one replica
  selector:
    matchLabels: {app: forge-api}
  template:
    metadata:
      labels: {app: forge-api}
    spec:
      securityContext:
        runAsNonRoot: true
        # distroless "nonroot" by number: the kubelet cannot check a user name.
        runAsUser: 65532
        runAsGroup: 65532
        # Secret files are root-owned; the group lets the API read its 0440 key.
        fsGroup: 65532
        seccompProfile: {type: RuntimeDefault}
      containers:
        - name: forge-api
          image: forge-api:dev
          imagePullPolicy: IfNotPresent
          env:
            - {name: FORGE_OIDC_ISSUER, value: "http://dex.example.test/dex"}
            - {name: FORGE_OIDC_CLIENT_ID, value: forge-cli}
            - {name: FORGE_WRITER_GROUPS, value: "showmino:platform-engineering"}
            - name: FORGE_DATABASE_URL
              valueFrom:
                secretKeyRef: {name: forge-db-app, key: uri}
            - {name: FORGE_LOG_FORMAT, value: json}
          ports:
            - {name: http, containerPort: 8080}
          readinessProbe:
            httpGet: {path: /healthz, port: http}
          livenessProbe:
            httpGet: {path: /healthz, port: http}
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: {drop: [ALL]}
          resources:
            requests: {cpu: 10m, memory: 32Mi}
            # Template releases are cached in memory (up to 100 MiB each).
            limits: {memory: 256Mi}
---
# Clusters without Traefik, and without MetalLB: Dex and forge-api each on a
# plain LoadBalancer Service, addressed by whatever the cluster's own
# LoadBalancer implementation assigns (a cloud provider, or `minikube
# tunnel` for a local proof) rather than a requested IP. dex.example.test and
# api.example.test are hostnames you already control and will point at that
# assigned address afterward, not derived from an IP:
#   host: dex.example.test  e.g. dex.example.com
#   host: api.example.test  e.g. forge.example.com
apiVersion: v1
kind: Service
metadata:
  name: dex
  namespace: forge
spec:
  type: LoadBalancer
  selector: {app: dex}
  ports:
    - {name: http, port: 80, targetPort: http}
---
apiVersion: v1
kind: Service
metadata:
  name: forge-api
  namespace: forge
spec:
  type: LoadBalancer
  selector: {app: forge-api}
  ports:
    - {name: http, port: 80, targetPort: http}
---
# Forge's database: the service catalog (forge-api) and Dex's logins.
# CloudNativePG creates the Secret forge-db-app (keys uri, password, ...)
# for the owner forge. No backups yet: the catalog can be re-registered from
# each repo's forge.yaml, and Dex's data is only sessions.
apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: forge-db
  namespace: forge
spec:
  instances: 2
  imageName: ghcr.io/cloudnative-pg/postgresql:18.4-system-trixie
  storage:
    size: 5Gi
    storageClass: longhorn-retain # the volumes outlive an accidental delete
  bootstrap:
    initdb:
      database: forge
      owner: forge
  resources:
    requests: {cpu: 50m, memory: 256Mi}
    limits: {memory: 512Mi}
---
apiVersion: postgresql.cnpg.io/v1
kind: Database
metadata:
  name: forge-db-dex
  namespace: forge
spec:
  name: dex
  owner: forge
  cluster:
    name: forge-db
