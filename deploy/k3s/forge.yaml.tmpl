# Forge Phase 1 on k3s: Dex + forge-api. How they are reached comes from
# ingress.yaml.tmpl (Traefik) or loadbalancer.yaml.tmpl (MetalLB and similar).
# Render with deploy/k3s/render.sh; do not apply this file directly.
#   ${DEX_HOST}         host name of Dex, the same for you and for pods
#   ${FORGE_API_IMAGE}  e.g. forge-api:dev (imported into k3s) or ghcr.io/showmino/forge-api:0.1.0
#   The GitHub App settings (ID, org, template repo): see render.sh.
#   FORGE_DEX_GITHUB_ORG, FORGE_WRITER_GROUPS (render.sh): GitHub login and who may write.
#   Lines with a trailing "app" marker comment exist only when render.sh gets a GitHub App ID.
apiVersion: v1
kind: Namespace
metadata:
  name: forge
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: dex-config
  namespace: forge
data:
  config.yaml: |
    issuer: http://${DEX_HOST}/dex
    storage:
      type: postgres
      config:
        host: forge-db-rw.forge.svc
        port: 5432
        database: dex
        user: forge
        password: $DEX_DB_PASSWORD # from the Secret forge-db-app
        ssl:
          mode: require
    web:
      http: 0.0.0.0:5556
    oauth2:
      grantTypes: [authorization_code, refresh_token, "urn:ietf:params:oauth:grant-type:device_code"]
      skipApprovalScreen: true
    expiry:
      idTokens: 1h
    staticClients:
      - id: forge-cli
        name: Forge CLI
        public: true
        redirectURIs: [/device/callback, http://127.0.0.1:8085/callback]
    # Only members of the org log in; groups are "<org>:<team-slug>", and
    # forge-api's FORGE_WRITER_GROUPS picks the teams that may write. Dex
    # expands $GITHUB_CLIENT_* from its environment (the Secret dex-github).
    connectors:
      - type: github
        id: github
        name: GitHub
        config:
          clientID: $GITHUB_CLIENT_ID
          clientSecret: $GITHUB_CLIENT_SECRET
          redirectURI: http://${DEX_HOST}/dex/callback
          orgs:
            - name: ${FORGE_DEX_GITHUB_ORG}
          teamNameField: slug
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: dex
  namespace: forge
spec:
  replicas: 1
  selector:
    matchLabels: {app: dex}
  template:
    metadata:
      labels: {app: dex}
    spec:
      containers:
        - name: dex
          image: ghcr.io/dexidp/dex:v2.41.1
          args: [dex, serve, /etc/dex/config.yaml]
          env:
            - name: GITHUB_CLIENT_ID
              valueFrom:
                secretKeyRef: {name: dex-github, key: client_id}
            - name: GITHUB_CLIENT_SECRET
              valueFrom:
                secretKeyRef: {name: dex-github, key: client_secret}
            - name: DEX_DB_PASSWORD
              valueFrom:
                secretKeyRef: {name: forge-db-app, key: password}
          ports:
            - {name: http, containerPort: 5556}
          readinessProbe:
            httpGet: {path: /dex/healthz, port: http}
          volumeMounts:
            - {name: config, mountPath: /etc/dex}
          resources:
            requests: {cpu: 10m, memory: 32Mi}
            limits: {memory: 128Mi}
      volumes:
        - name: config
          configMap: {name: dex-config}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: forge-api
  namespace: forge
spec:
  replicas: 1 # operations are in memory; keep one replica
  selector:
    matchLabels: {app: forge-api}
  template:
    metadata:
      labels: {app: forge-api}
    spec:
      serviceAccountName: forge-api #previews
      securityContext:
        runAsNonRoot: true
        # distroless "nonroot" by number: the kubelet cannot check a user name.
        runAsUser: 65532
        runAsGroup: 65532
        # Secret files are root-owned; the group lets the API read its 0440 key.
        fsGroup: 65532
        seccompProfile: {type: RuntimeDefault}
      volumes: #app
        - name: github-app #app
          secret: {secretName: forge-github-app, defaultMode: 0440} #app
      containers:
        - name: forge-api
          image: ${FORGE_API_IMAGE}
          imagePullPolicy: IfNotPresent
          env:
            - {name: FORGE_OIDC_ISSUER, value: "http://${DEX_HOST}/dex"}
            - {name: FORGE_OIDC_CLIENT_ID, value: forge-cli}
            - {name: FORGE_WRITER_GROUPS, value: "${FORGE_WRITER_GROUPS}"}
            - name: FORGE_DATABASE_URL
              valueFrom:
                secretKeyRef: {name: forge-db-app, key: uri}
            - {name: FORGE_LOG_FORMAT, value: json}
            - {name: FORGE_GITHUB_APP_ID, value: "${FORGE_GITHUB_APP_ID}"} #app
            - {name: FORGE_GITHUB_APP_KEY_FILE, value: /etc/forge/github-app/github_app_private_key} #app
            - {name: FORGE_GITHUB_ORG, value: ${FORGE_GITHUB_ORG}} #app
            - {name: FORGE_TEMPLATES_REPO, value: ${FORGE_TEMPLATES_REPO}} #app
            - {name: FORGE_PREVIEWS, value: "1"} #previews
            - {name: FORGE_PREVIEW_DOMAIN, value: preview.${PREVIEW_IP}.nip.io} #previews
            - {name: FORGE_PREVIEW_PULL_SECRET, value: forge/${PULL_SECRET}} #previews
            - {name: FORGE_DEPLOYS, value: "1"} #deploys
            - {name: FORGE_RESOURCES, value: "1"} #resources
            - {name: FORGE_RUNNER_IMAGE, value: "${FORGE_RUNNER_IMAGE}"} #resources
          volumeMounts: #app
            - {name: github-app, mountPath: /etc/forge/github-app, readOnly: true} #app
          ports:
            - {name: http, containerPort: 8080}
            - {name: runner, containerPort: 8081} #resources
          readinessProbe:
            httpGet: {path: /healthz, port: http}
          livenessProbe:
            httpGet: {path: /healthz, port: http}
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: {drop: [ALL]}
          resources:
            requests: {cpu: 10m, memory: 32Mi}
            # Template releases are cached in memory (up to 100 MiB each).
            limits: {memory: 256Mi}
