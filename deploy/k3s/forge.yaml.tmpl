# Forge Phase 1 on k3s: Dex + forge-api behind the bundled Traefik ingress.
# Render with deploy/k3s/render.sh; do not apply this file directly.
#   ${FORGE_DOMAIN}     e.g. 192.168.1.50.nip.io (any name that resolves to the node, for you and for pods)
#   ${FORGE_API_IMAGE}  e.g. forge-api:dev (imported into k3s) or ghcr.io/showmino/forge-api:0.1.0
apiVersion: v1
kind: Namespace
metadata:
  name: forge
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: dex-config
  namespace: forge
data:
  config.yaml: |
    issuer: http://dex.${FORGE_DOMAIN}/dex
    storage:
      type: memory # Phase 1: logins reset when Dex restarts
    web:
      http: 0.0.0.0:5556
    oauth2:
      grantTypes: [authorization_code, refresh_token, "urn:ietf:params:oauth:grant-type:device_code"]
      skipApprovalScreen: true
    expiry:
      idTokens: 1h
    staticClients:
      - id: forge-cli
        name: Forge CLI
        public: true
        redirectURIs: [/device/callback, http://127.0.0.1:8085/callback]
    enablePasswordDB: true
    staticPasswords:
      - email: admin@example.com
        hash: "$2a$10$2b2cU8CPhOTaGrs1HRQuAueS7JTT5ZHsHSzYiFPm1leZck7Mc8T4W" # "password": change it
        username: admin
        userID: 08a8684b-db88-4b73-90a9-3cd1661f5466
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: dex
  namespace: forge
spec:
  replicas: 1
  selector:
    matchLabels: {app: dex}
  template:
    metadata:
      labels: {app: dex}
    spec:
      containers:
        - name: dex
          image: ghcr.io/dexidp/dex:v2.41.1
          args: [dex, serve, /etc/dex/config.yaml]
          ports:
            - {name: http, containerPort: 5556}
          readinessProbe:
            httpGet: {path: /dex/healthz, port: http}
          volumeMounts:
            - {name: config, mountPath: /etc/dex}
          resources:
            requests: {cpu: 10m, memory: 32Mi}
            limits: {memory: 128Mi}
      volumes:
        - name: config
          configMap: {name: dex-config}
---
apiVersion: v1
kind: Service
metadata:
  name: dex
  namespace: forge
spec:
  selector: {app: dex}
  ports:
    - {name: http, port: 5556, targetPort: http}
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: dex
  namespace: forge
spec:
  ingressClassName: traefik
  rules:
    - host: dex.${FORGE_DOMAIN}
      http:
        paths:
          - path: /dex
            pathType: Prefix
            backend:
              service: {name: dex, port: {name: http}}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: forge-api
  namespace: forge
spec:
  replicas: 1 # the Phase 1 catalog is in memory; keep one replica
  selector:
    matchLabels: {app: forge-api}
  template:
    metadata:
      labels: {app: forge-api}
    spec:
      securityContext:
        runAsNonRoot: true
        seccompProfile: {type: RuntimeDefault}
      containers:
        - name: forge-api
          image: ${FORGE_API_IMAGE}
          imagePullPolicy: IfNotPresent
          env:
            - {name: FORGE_OIDC_ISSUER, value: "http://dex.${FORGE_DOMAIN}/dex"}
            - {name: FORGE_OIDC_CLIENT_ID, value: forge-cli}
            - {name: FORGE_LOG_FORMAT, value: json}
          ports:
            - {name: http, containerPort: 8080}
          readinessProbe:
            httpGet: {path: /healthz, port: http}
          livenessProbe:
            httpGet: {path: /healthz, port: http}
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: {drop: [ALL]}
          resources:
            requests: {cpu: 10m, memory: 32Mi}
            limits: {memory: 128Mi}
---
apiVersion: v1
kind: Service
metadata:
  name: forge-api
  namespace: forge
  annotations:
    # Traefik talks HTTP/2 cleartext to the pod, so gRPC clients work too.
    traefik.ingress.kubernetes.io/service.serversscheme: h2c
spec:
  selector: {app: forge-api}
  ports:
    - {name: http, port: 80, targetPort: http}
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: forge-api
  namespace: forge
spec:
  ingressClassName: traefik
  rules:
    - host: forge.${FORGE_DOMAIN}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service: {name: forge-api, port: {name: http}}
