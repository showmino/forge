# Forge's database: the service catalog (forge-api) and Dex's logins.
# CloudNativePG creates the Secret forge-db-app (keys uri, password, ...)
# for the owner forge. No backups yet: the catalog can be re-registered from #nobackups
# each repo's forge.yaml, and Dex's data is only sessions. #nobackups
# Backed up to Azure Blob with point-in-time recovery: backups.yaml.tmpl. #backups
apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: forge-db
  namespace: forge
spec:
  instances: 2
  imageName: ghcr.io/cloudnative-pg/postgresql:18.4-system-trixie
  storage:
    size: 5Gi
    storageClass: ${DB_STORAGE_CLASS} # the volumes outlive an accidental delete #dbstorage
  bootstrap:
    initdb:
      database: forge
      owner: forge
  resources:
    requests: {cpu: 50m, memory: 256Mi}
    limits: {memory: 512Mi}
  plugins: #backups
    - name: barman-cloud.cloudnative-pg.io #backups
      enabled: true #backups
      isWALArchiver: true #backups
      parameters: {barmanObjectName: forge-db-azure${BACKUP_SERVER_PARAM}} #backups
---
apiVersion: postgresql.cnpg.io/v1
kind: Database
metadata:
  name: forge-db-dex
  namespace: forge
spec:
  name: dex
  owner: forge
  cluster:
    name: forge-db
