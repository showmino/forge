# Clusters without Traefik: Dex and forge-api each on their own LoadBalancer
# IP on port 80 (MetalLB 0.13+ honours the requested IPs; other implementations may
# ignore the annotation, so check 'kubectl -n forge get svc').
#   ${DEX_IP}  e.g. 10.150.1.220, reached as dex.10.150.1.220.nip.io
#   ${API_IP}  e.g. 10.150.1.221, reached as forge.10.150.1.221.nip.io
apiVersion: v1
kind: Service
metadata:
  name: dex
  namespace: forge
  annotations:
    metallb.universe.tf/loadBalancerIPs: ${DEX_IP}
spec:
  type: LoadBalancer
  selector: {app: dex}
  ports:
    - {name: http, port: 80, targetPort: http}
---
apiVersion: v1
kind: Service
metadata:
  name: forge-api
  namespace: forge
  annotations:
    metallb.universe.tf/loadBalancerIPs: ${API_IP}
spec:
  type: LoadBalancer
  selector: {app: forge-api}
  ports:
    - {name: http, port: 80, targetPort: http}
