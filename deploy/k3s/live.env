# The settings of the Forge that runs on the owner's k3s cluster: what
# render-live.sh renders into live/forge.yaml, which Argo CD compares with the
# cluster. No secrets: those come from 1Password items named here.
FORGE_API_IMAGE=ghcr.io/showmino/forge-api:v0.25.0
FORGE_LB_DEX_IP=10.150.1.220
FORGE_LB_API_IP=10.150.1.221
FORGE_GITHUB_ORG=showmino
FORGE_GITHUB_APP_ID=5239131
FORGE_ONEPASSWORD_ITEM=vaults/Kube/items/forge-github-app
FORGE_DEX_ONEPASSWORD_ITEM=vaults/Kube/items/forge-dex-github
FORGE_PREVIEW_IP=10.150.1.222
FORGE_PREVIEW_PULL_SECRET=mino-ghcr
FORGE_DEPLOYS=1
FORGE_RESOURCES=1
FORGE_RUNNER_IMAGE=ghcr.io/showmino/forge-runner:v0.23.1
FORGE_DEPLOY_CHART_REVISION=0.21.0
FORGE_WEB_ORIGINS=https://forge.showmino.com,https://forge-staging.showmino.com
FORGE_PUBLIC_DOMAINS=showmino.com=showmino-com,deogratias.cloud=deogratias-cloud,forgegate.io=forgegate-io
FORGE_LOGIN_URL=https://forge-login.showmino.com
FORGE_ARGOCD_URL=https://argocd.showmino.com
FORGE_SECRET_VAULTS=Kube
FORGE_SECRET_DENIED_ITEMS=forge-github-app,forge-dex-github,ghcr-secret,arc-runners,argocd-repo-kubernetes,cert-manager,Cloudflare,crossplane-cloudflare,crossplane-github-provider-creds,grafana-admin-credentials,renovate,forge-backup-storage
FORGE_DB_STORAGE_CLASS=longhorn-retain
FORGE_DEX_THEME=1
FORGE_CLUSTERS=1
FORGE_GRAFANA_URL=https://grafana.showmino.com
FORGE_PROMETHEUS_URL=http://prometheus-prometheus.monitoring.svc:9090
