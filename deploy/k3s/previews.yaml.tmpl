# Preview environments: forge-api's ServiceAccount and cluster permissions, and
# the LAN Gateway previews are reached through. render.sh adds this when
# FORGE_PREVIEW_IP is set.
#   ${PREVIEW_IP}   MetalLB IP of the Gateway, e.g. 10.150.1.222
#   ${PULL_SECRET}  dockerconfigjson Secret in namespace forge, e.g. mino-ghcr
apiVersion: v1
kind: ServiceAccount
metadata:
  name: forge-api
  namespace: forge
imagePullSecrets:
  - name: ${PULL_SECRET}
---
# Exactly the calls internal/server/env_cluster.go makes. Kubernetes RBAC
# cannot limit them to Forge's own namespaces; forge-api enforces that itself
# (owned() in env_cluster.go).
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: forge-api-previews
rules:
  - apiGroups: [""]
    resources: [namespaces]
    verbs: [get, list, create, patch, delete]
  - apiGroups: [""]
    resources: [secrets, services, resourcequotas, limitranges]
    verbs: [create]
  - apiGroups: [""]
    resources: [pods]
    verbs: [list]
  - apiGroups: [apps]
    resources: [deployments]
    verbs: [get, create]
  - apiGroups: [gateway.networking.k8s.io]
    resources: [httproutes]
    verbs: [create]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: forge-api-previews
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: forge-api-previews
subjects:
  - {kind: ServiceAccount, name: forge-api, namespace: forge}
---
# forge-api reads the pull secret to copy it into previews and to check images.
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: forge-api-pull-secret
  namespace: forge
rules:
  - apiGroups: [""]
    resources: [secrets]
    resourceNames: [${PULL_SECRET}]
    verbs: [get]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: forge-api-pull-secret
  namespace: forge
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: forge-api-pull-secret
subjects:
  - {kind: ServiceAccount, name: forge-api, namespace: forge}
---
# LAN only: Istio deploys this Gateway as forge-previews-istio with a
# LoadBalancer Service, which MetalLB gives ${PREVIEW_IP}.
apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: forge-previews
  namespace: forge
spec:
  gatewayClassName: istio
  infrastructure:
    annotations:
      metallb.universe.tf/loadBalancerIPs: ${PREVIEW_IP}
  listeners:
    - name: http
      protocol: HTTP
      port: 80
      hostname: "*.preview.${PREVIEW_IP}.nip.io"
      allowedRoutes:
        namespaces:
          from: Selector
          selector:
            matchLabels:
              app.kubernetes.io/managed-by: forge
    - name: staging #deploys
      protocol: HTTP #deploys
      port: 80 #deploys
      hostname: "*.staging.${PREVIEW_IP}.nip.io" #deploys
      allowedRoutes: #deploys
        namespaces: #deploys
          from: Selector #deploys
          selector: #deploys
            matchLabels: #deploys
              app.kubernetes.io/managed-by: forge #deploys
              forge.dev/deploy-env: staging #deploys
    - name: production #deploys
      protocol: HTTP #deploys
      port: 80 #deploys
      hostname: "*.production.${PREVIEW_IP}.nip.io" #deploys
      allowedRoutes: #deploys
        namespaces: #deploys
          from: Selector #deploys
          selector: #deploys
            matchLabels: #deploys
              app.kubernetes.io/managed-by: forge #deploys
              forge.dev/deploy-env: production #deploys
    # Public addresses (FORGE_PUBLIC_DOMAINS): one listener per domain, named #public
    # public-<zone>, for the hosts the Cloudflare tunnel sends here. Each #public
    # takes only hosts under its domain, and only routes from the namespace #public
    # of a Forge deployment, never from a preview. #public
    #public-listeners
