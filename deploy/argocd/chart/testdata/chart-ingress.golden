---
# Source: forge-chart/templates/limits.yaml
apiVersion: v1
kind: ResourceQuota
metadata:
  name: forge
spec:
  hard:
    # Room for the app and, next to it, a database of up to three instances.
    requests.cpu: "2"
    requests.memory: 2Gi
    limits.cpu: "4"
    limits.memory: 4Gi
    pods: "15"
---
# Source: forge-chart/templates/limits.yaml
apiVersion: v1
kind: LimitRange
metadata:
  name: forge
spec:
  limits:
    - type: Container
      defaultRequest: {cpu: 50m, memory: 64Mi}
      default: {cpu: 500m, memory: 512Mi}
---
# Source: forge-chart/templates/ingress.yaml
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: podinfo
  annotations:
    cert-manager.io/cluster-issuer: "letsencrypt"
spec:
  ingressClassName: "nginx"
  tls:
    - hosts: ["payments.staging.apps.acme.example"]
      secretName: podinfo-tls
  rules:
    - host: "payments.staging.apps.acme.example"
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: podinfo
                port: {number: 9898}
---
# Source: forge-chart/templates/chartproject.yaml
apiVersion: argoproj.io/v1alpha1
kind: AppProject
metadata:
  name: forge-chart-podinfo-staging
  namespace: argocd
spec:
  description: "The chart podinfo of the Forge service podinfo in staging"
  sourceRepos:
    - "*"
  destinations:
    - {server: https://kubernetes.default.svc, namespace: "podinfo-staging"}
  clusterResourceWhitelist: []
  namespaceResourceWhitelist:
    - {group: "*", kind: "*"}
  namespaceResourceBlacklist:
    - {group: gateway.networking.k8s.io, kind: "*"}
    - {group: networking.k8s.io, kind: Ingress}
    - {group: extensions, kind: Ingress}
    - {group: "", kind: ResourceQuota}
    - {group: "", kind: LimitRange}
    - {group: kro.run, kind: "*"}
    - {group: onepassword.com, kind: "*"}
    - {group: external-secrets.io, kind: "*"}
    - {group: argoproj.io, kind: "*"}
