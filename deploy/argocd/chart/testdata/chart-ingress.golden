---
# Source: forge-chart/templates/limits.yaml
apiVersion: v1
kind: ResourceQuota
metadata:
  name: forge
spec:
  hard:
    # Room for the app and, next to it, a database of up to three instances.
    requests.cpu: "2"
    requests.memory: 2Gi
    limits.cpu: "4"
    limits.memory: 4Gi
    pods: "15"
---
# Source: forge-chart/templates/limits.yaml
apiVersion: v1
kind: LimitRange
metadata:
  name: forge
spec:
  limits:
    - type: Container
      defaultRequest: {cpu: 50m, memory: 64Mi}
      default: {cpu: 500m, memory: 512Mi}
---
# Source: forge-chart/templates/ingress.yaml
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: podinfo
  annotations:
    cert-manager.io/cluster-issuer: "letsencrypt"
spec:
  ingressClassName: "nginx"
  tls:
    - hosts: ["payments.staging.apps.acme.example"]
      secretName: podinfo-tls
  rules:
    - host: "payments.staging.apps.acme.example"
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: podinfo
                port: {number: 9898}
---
# Source: forge-chart/templates/chartproject.yaml
apiVersion: argoproj.io/v1alpha1
kind: AppProject
metadata:
  name: "forge-chart-podinfo-staging"
  namespace: argocd
spec:
  description: "The chart podinfo of the Forge service podinfo in staging"
  sourceRepos:
    - "*"
  destinations:
    - {server: https://kubernetes.default.svc, namespace: "podinfo-staging"}
  clusterResourceWhitelist: []
  # Workloads and what they need, nothing else: no RBAC (a Role would let
  # the chart's own pods make routes, DNS records or secrets items later), no
  # routes, Ingresses, Endpoints or EndpointSlices (Forge gives the service
  # its address, and the route must lead to the chart's own pods), no quotas,
  # and none of the cluster's other kinds (Istio, cert-manager, monitoring,
  # secrets operators). A Service must be a plain ClusterIP: the platform's
  # admission policy refuses the other types in Forge's namespaces.
  namespaceResourceWhitelist:
    - {group: "", kind: ConfigMap}
    - {group: "", kind: Secret}
    - {group: "", kind: Service}
    - {group: "", kind: ServiceAccount}
    - {group: "", kind: PersistentVolumeClaim}
    - {group: "", kind: Pod}
    - {group: apps, kind: Deployment}
    - {group: apps, kind: StatefulSet}
    - {group: apps, kind: DaemonSet}
    - {group: apps, kind: ReplicaSet}
    - {group: batch, kind: Job}
    - {group: batch, kind: CronJob}
    - {group: autoscaling, kind: HorizontalPodAutoscaler}
    - {group: policy, kind: PodDisruptionBudget}
    - {group: networking.k8s.io, kind: NetworkPolicy}
