---
# Source: forge-chart/templates/limits.yaml
apiVersion: v1
kind: ResourceQuota
metadata:
  name: forge
spec:
  hard:
    # Room for the app and, next to it, a database of up to three instances.
    requests.cpu: "2"
    requests.memory: 2Gi
    limits.cpu: "4"
    limits.memory: 4Gi
    pods: "15"
---
# Source: forge-chart/templates/limits.yaml
apiVersion: v1
kind: LimitRange
metadata:
  name: forge
spec:
  limits:
    - type: Container
      defaultRequest: {cpu: 50m, memory: 64Mi}
      default: {cpu: 500m, memory: 512Mi}
---
# Source: forge-chart/templates/service.yaml
apiVersion: v1
kind: Service
metadata:
  name: payments
spec:
  selector: {app: payments}
  ports:
    - {name: http, port: 80, targetPort: 9090}
---
# Source: forge-chart/templates/deployment.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: payments
  labels: {app: payments}
spec:
  replicas: 1
  selector:
    matchLabels: {app: payments}
  template:
    metadata:
      labels: {app: payments}
    spec:
      automountServiceAccountToken: false
      imagePullSecrets:
        - name: forge-pull
      securityContext:
        runAsNonRoot: true
        seccompProfile: {type: RuntimeDefault}
      # The root filesystem is read-only; /tmp is the one writable path.
      volumes:
        - name: tmp
          emptyDir: {sizeLimit: 256Mi}
      containers:
        - name: payments
          image: ghcr.io/showmino/payments:1a2b3c4
          ports:
            - {name: http, containerPort: 9090}
          env:
            - {name: PORT, value: "9090"}
            # The connection string CloudNativePG keeps for the service's database.
            - name: DATABASE_URL
              valueFrom:
                secretKeyRef: {name: main-app, key: uri}
          readinessProbe:
            httpGet: {path: /ready, port: 9090}
            periodSeconds: 5
          livenessProbe:
            httpGet: {path: /ready, port: 9090}
            initialDelaySeconds: 10
            periodSeconds: 5
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: {drop: [ALL]}
          volumeMounts:
            - {name: tmp, mountPath: /tmp}
---
# Source: forge-chart/templates/httproute.yaml
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: payments
spec:
  parentRefs:
    # A public address attaches to the Gateway's public listener; an internal
    # one to the listener of its environment.
    - {name: forge-previews, namespace: forge, sectionName: staging}
  hostnames: ["payments.staging.10.150.1.222.nip.io"]
  rules:
    - backendRefs:
        - {name: payments, port: 80}
