---
# Source: forge-service/templates/limits.yaml
apiVersion: v1
kind: ResourceQuota
metadata:
  name: forge
spec:
  hard:
    # Room for the app and, next to it, a database of up to three instances.
    requests.cpu: "2"
    requests.memory: 2Gi
    limits.cpu: "4"
    limits.memory: 4Gi
    pods: "15"
---
# Source: forge-service/templates/limits.yaml
apiVersion: v1
kind: LimitRange
metadata:
  name: forge
spec:
  limits:
    - type: Container
      defaultRequest: {cpu: 50m, memory: 64Mi}
      default: {cpu: 500m, memory: 512Mi}
---
# Source: forge-service/templates/service.yaml
apiVersion: v1
kind: Service
metadata:
  name: payments
spec:
  selector: {app: payments}
  ports:
    - {name: http, port: 80, targetPort: 9090}
---
# Source: forge-service/templates/deployment.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: payments
  labels: {app: payments}
  # KEDA owns the replica count; Argo CD ignores it on Deployments marked so.
  annotations: {forge.dev/autoscaled: "true"}
spec:
  replicas: 2
  selector:
    matchLabels: {app: payments}
  template:
    metadata:
      labels: {app: payments}
    spec:
      automountServiceAccountToken: false
      imagePullSecrets:
        - name: forge-pull
      securityContext:
        runAsNonRoot: true
        seccompProfile: {type: RuntimeDefault}
      # The root filesystem is read-only; /tmp is the one writable path.
      volumes:
        - name: tmp
          emptyDir: {sizeLimit: 256Mi}
      containers:
        - name: payments
          image: ghcr.io/showmino/payments:1a2b3c4
          ports:
            - {name: http, containerPort: 9090}
          env:
            - {name: PORT, value: "9090"}
            # The connection string CloudNativePG keeps for the service's database.
            - name: DATABASE_URL
              valueFrom:
                secretKeyRef: {name: main-app, key: uri}
            - {name: FEATURE_X, value: "true"}
            - {name: LOG_LEVEL, value: "info"}
            - name: STRIPE_HOOK
              valueFrom:
                secretKeyRef: {name: stripe-1password, key: "webhook-secret"}
            - name: STRIPE_KEY
              valueFrom:
                secretKeyRef: {name: stripe-1password, key: "credential"}
          resources:
            limits:
              cpu: 500m
              memory: 512Mi
            requests:
              cpu: 100m
              memory: 128Mi
          readinessProbe:
            httpGet: {path: /ready, port: 9090}
            periodSeconds: 5
          livenessProbe:
            httpGet: {path: /ready, port: 9090}
            initialDelaySeconds: 10
            periodSeconds: 5
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: {drop: [ALL]}
          volumeMounts:
            - {name: tmp, mountPath: /tmp}
---
# Source: forge-service/templates/cronjob.yaml
apiVersion: batch/v1
kind: CronJob
metadata:
  name: payments-cleanup
  labels: {app: payments, forge.dev/job: cleanup}
spec:
  schedule: "0 3 * * *"
  concurrencyPolicy: Forbid
  successfulJobsHistoryLimit: 3
  failedJobsHistoryLimit: 3
  jobTemplate:
    spec:
      backoffLimit: 2
      # A run that hangs would hold its share of the quota and, with Forbid,
      # every later run.
      activeDeadlineSeconds: 3600
      template:
        metadata:
          labels: {forge.dev/job: cleanup}
        spec:
          restartPolicy: Never
          automountServiceAccountToken: false
          imagePullSecrets:
            - name: forge-pull
          securityContext:
            runAsNonRoot: true
            seccompProfile: {type: RuntimeDefault}
          volumes:
            - name: tmp
              emptyDir: {sizeLimit: 256Mi}
          containers:
            - name: cleanup
              image: ghcr.io/showmino/payments:1a2b3c4
              command:
                - "node"
                - "scripts/cleanup.js"
              env:
                - {name: PORT, value: "9090"}
                # The connection string CloudNativePG keeps for the service's database.
                - name: DATABASE_URL
                  valueFrom:
                    secretKeyRef: {name: main-app, key: uri}
                - {name: FEATURE_X, value: "true"}
                - {name: LOG_LEVEL, value: "info"}
                - name: STRIPE_HOOK
                  valueFrom:
                    secretKeyRef: {name: stripe-1password, key: "webhook-secret"}
                - name: STRIPE_KEY
                  valueFrom:
                    secretKeyRef: {name: stripe-1password, key: "credential"}
              resources:
                limits:
                  cpu: 500m
                  memory: 512Mi
                requests:
                  cpu: 100m
                  memory: 128Mi
              securityContext:
                allowPrivilegeEscalation: false
                readOnlyRootFilesystem: true
                capabilities: {drop: [ALL]}
              volumeMounts:
                - {name: tmp, mountPath: /tmp}
---
# Source: forge-service/templates/httproute.yaml
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: payments
spec:
  parentRefs:
    # A public address attaches to the Gateway's public listener; an internal
    # one to the listener of its environment.
    - {name: forge-previews, namespace: forge, sectionName: production}
  hostnames: ["payments.production.10.150.1.222.nip.io"]
  rules:
    - backendRefs:
        - {name: payments, port: 80}
---
# Source: forge-service/templates/onepassword.yaml
apiVersion: onepassword.com/v1
kind: OnePasswordItem
metadata:
  name: stripe-1password
spec:
  itemPath: "vaults/Apps/items/stripe"
---
# Source: forge-service/templates/scaledobject.yaml
apiVersion: keda.sh/v1alpha1
kind: ScaledObject
metadata:
  name: payments
spec:
  scaleTargetRef:
    name: payments
  minReplicaCount: 2
  maxReplicaCount: 6
  triggers:
    - type: cpu
      metricType: Utilization
      metadata:
        value: "70"
