{
  "templates": [
    {
      "name": "templates/svc",
      "version": "dev",
      "title": "Go service",
      "description": "Go service fixture",
      "tags": [
        "go",
        "grpc"
      ],
      "owner": "platform",
      "parameters": [
        {
          "name": "port",
          "type": "TYPE_INT",
          "defaultValue": "8080",
          "description": "Port the server listens on"
        },
        {
          "name": "tier",
          "type": "TYPE_ENUM",
          "required": true,
          "values": [
            "gold",
            "silver"
          ],
          "description": "Support tier"
        }
      ],
      "type": "service"
    },
    {
      "name": "templates/web",
      "version": "dev",
      "title": "Web app",
      "description": "Web fixture",
      "tags": [
        "node"
      ],
      "type": "service"
    }
  ]
}
