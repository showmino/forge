---
apiVersion: repo.github.m.upbound.io/v1alpha1
kind: Environment
metadata:
  labels:
    forge.dev/deploy-env: staging
    forge.dev/service: infra-net
  name: infra-net-staging
spec:
  forProvider:
    canAdminsBypass: false
    environment: staging
    repository: infra-net
  providerConfigRef:
    kind: ClusterProviderConfig
    name: github
---
apiVersion: actions.github.m.upbound.io/v1alpha1
kind: EnvironmentSecret
metadata:
  labels:
    forge.dev/deploy-env: staging
    forge.dev/service: infra-net
  name: infra-net-staging-azure-client-id
spec:
  forProvider:
    environment: staging
    plaintextValueSecretRef:
      key: clientId
      name: target-azure-staging
    repository: infra-net
    secretName: AZURE_CLIENT_ID
  providerConfigRef:
    kind: ClusterProviderConfig
    name: github
